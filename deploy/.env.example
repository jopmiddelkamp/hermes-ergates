# Copy this file to .env and fill in real values. Never commit .env.
#
# Every value below is a neutral example, not a working credential. This
# file (.env.example) is safe to commit; a filled-in .env never is -- see
# deploy/README.md "First-run credential provisioning".

# --- Networking -------------------------------------------------------------

# The VPS's own Tailscale IP (run `tailscale ip -4` on the VPS). hermes-serve
# and ntfy publish only on this address, never on 0.0.0.0 (03 section 9).
TAILSCALE_IP=100.64.0.1

# Host port ntfy's HTTP listener is published on, at TAILSCALE_IP.
NTFY_PORT=8080

# --- Data volumes ------------------------------------------------------------

# Host paths bind-mounted into the containers. Point these at real, backed-up
# storage before going beyond a first smoke test -- see the backup section in
# deploy/README.md.
HERMES_DATA_DIR=./data/hermes
NTFY_DATA_DIR=./data/ntfy

# --- Dashboard basic auth (hermes-serve) ------------------------------------

# Generate real values BEFORE the first `up -d`, not after: the dashboard bind
# is non-loopback, so Hermes's auth gate is on from the first request and these
# placeholders would satisfy it. See deploy/README.md "Install".
#
# HERMES_DASHBOARD_BASIC_AUTH_SECRET keeps sessions valid across a container
# restart -- generate it once with `openssl rand -hex 32` and treat it as a
# secret, not a password.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=change-me
HERMES_DASHBOARD_BASIC_AUTH_SECRET=change-me

# Password HASH, not the password (04 section 6). Produce it with the command
# in deploy/README.md, then ESCAPE EVERY '$' AS '$$' before pasting it here:
# Compose interpolates .env values, so an unescaped `scrypt$16384$8$1$...`
# silently loses everything after the first '$16384' and the login then fails.
#   printf '%s\n' "$HASH" | sed 's/\$/$$/g'
# The example below is a syntactically valid but useless hash of a random
# string -- it is not a working credential.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$$16384$$8$$1$$Y2hhbmdlLW1lLXNhbHQ=$$Y2hhbmdlLW1lLXBsZWFzZS1yZXBsYWNlLXRoaXMtdmFsdWU=

# Fallback only, normally left empty. A non-empty value takes PRECEDENCE over
# the hash above (the provider hashes it in memory each start), which puts the
# plaintext at rest in this file -- use it only if the hash command is
# unavailable, and replace it with a hash afterwards.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# --- ntfy --------------------------------------------------------------------

# Upstream wake-up service for self-hosted iOS instant delivery; normally
# left at the public default (11 section 4.2).
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# --- Docker socket group access (UNVERIFIED -- see deploy/README.md) --------

# GID of /var/run/docker.sock on the host, so the container's non-root
# `hermes` user (after the image's s6 privilege drop) can reach the daemon.
# Find it with: stat -c '%g' /var/run/docker.sock
# This is flagged as an unverified gate: group_add applies to the container's
# PID 1 and may not survive that privilege drop. Confirm with
# `docker compose exec hermes-serve id` and `docker compose exec hermes-serve docker ps`
# before relying on it.
DOCKER_SOCK_GID=999
