# Copy this file to .release/release.env (git-ignored) and fill it in. RELEASING.md says where each value comes from.
# Put the two key files next to it:
#   .release/asc-api-key.p8              App Store Connect API key (Admin role)
#   .release/play-service-account.json   Google Play service account key

# Expo personal access token (secret). expo.dev > Account settings > Access tokens.
EXPO_TOKEN=

# Apple. Not secret on their own; the .p8 file is the secret.
APPLE_TEAM_ID=          # 10 characters: developer.apple.com > Account > Membership details
APPLE_TEAM_TYPE=        # optional: INDIVIDUAL, COMPANY_OR_ORGANIZATION or IN_HOUSE
ASC_KEY_ID=             # App Store Connect > Users and Access > Integrations > the key's Key ID
ASC_ISSUER_ID=          # same page, "Issuer ID" above the key list
ASC_APP_ID=             # App Store Connect > the Ergates app > App Information > Apple ID (digits)

# Google Play. Keep "draft" until the Play app has left draft status (store listing and setup done).
PLAY_RELEASE_STATUS=draft
